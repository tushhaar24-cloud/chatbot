# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_app

# --- CORS ---
# Origins allowed to call this API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
# Signing key for JWTs. Anyone holding this can mint tokens for any user.
# Generate a fresh one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-your-own
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI / LLM provider (used from Milestone 6) ---
# Groq exposes an OpenAI-compatible API, so the base URL ends in /openai/v1.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
# Seconds to wait for the LLM before giving up (BRD FR-10: AI timeout).
AI_TIMEOUT_SECONDS=30
